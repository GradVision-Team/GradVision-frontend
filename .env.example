# Set to true to use sample data in the app (optional; keep off in production)
# NEXT_PUBLIC_USE_SAMPLE_DATA=true

# Backend API base URL (must include the /api path segment).
# Read by getApiBaseUrl() on the server (BFF routes + SSR). Browser clients
# still call same-origin /api/...; the Next.js routes proxy to this URL.
#
# Local development (.env.local):
NEXT_PUBLIC_API_URL=http://localhost:8000/api
#
# Production (set this in the Vercel project Environment Variables, then redeploy):
# NEXT_PUBLIC_API_URL=https://gradvision-backend.onrender.com/api
